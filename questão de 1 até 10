def somador(x, y):
    soma = x + y
    print (soma)
def subtrair (x, y):
    sub = x - y
    print(sub)
def divisor(x, y):
    div = x // y
    print(div)
def multiplicador(x, y):
    multi = x * y
    print(multi)

print("1- soma""\n""2- subtração""\n""3- divisão""\n""4- multiplicação""\n")

pupum = int(input("escolha o tipo de operação:"))

if pupum == 1:
    x = int(input("digite um número para somar:"))
    y = int(input("digite um número para somar:"))
    somador(x, y)
elif pupum == 2:
    x = int(input("digite um número para subtrair:"))
    y = int(input("digite um número para subtrair:"))
    subtrair(x, y)
elif pupum == 3:
